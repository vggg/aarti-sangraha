  "aartis": [
    {
      "id": "GAN",
      "title_mr": "श्री गणपतीची आरती",
      "title_en": "Ganpati Aarti",
      "incipit_mr": "सुखकर्ता दुःखहर्ता",
      "seal": "॥ श्री गणेशाय नमः ॥",
      "accent": "#C8621A",
      "source_photo": "IMG_09F88790-2D24-4305-9B6A-12066F67AD54.jpeg",
      "lines": [
        {
          "id": "GAN-001",
          "mr": "सुखकर्ता दुःखहर्ता वार्ता विघ्नाची ।",
          "ro": "Sukh-kar-taa Dukh-har-taa Vaar-taa Vigh-naa-chee",
          "type": "verse"
        },
        {
          "id": "GAN-002",
          "mr": "नुरवी पुरवी प्रेम कृपा जयाची ।",
          "ro": "Nur-vee Pur-vee Prem Kru-paa Ja-yaa-chee",
          "type": "verse"
        },
        {
          "id": "GAN-003",
          "mr": "सर्वांगी सुंदर उटी शेंदुराची ।",
          "ro": "Sar-vaan-gee Sun-dar U-tee Shen-du-raa-chee",
          "type": "verse"
        },
        {
          "id": "GAN-004",
          "mr": "कंठी झळके माळ मुक्ताफळांची ॥१॥",
          "ro": "Kan-thee Jhal-ke Maal Muk-taa-pha-laan-chee",
          "type": "verse"
        },
        {
          "id": "GAN-R01",
          "mr": "जय देव जय देव जय मंगलमूर्ती ।",
          "ro": "Jai Dev Jai Dev Jai Man-gal-moor-tee",
          "type": "refrain"
        },
        {
          "id": "GAN-R02",
          "mr": "दर्शनमात्रे मनकामना पुरती ॥धृ॥",
          "ro": "Dar-shan-maa-tre Man-kaam-naa Pur-tee",
          "type": "refrain"
        },
        {
          "id": "GAN-005",
          "mr": "रत्नखचित फरा तुज गौरीकुमरा ।",
          "ro": "Rat-na-kha-chit Pha-raa Tuj Gau-ree-ku-ma-raa",
          "type": "verse"
        },
        {
          "id": "GAN-006",
          "mr": "चंदनाची उटी कुंकुमकेशरा ।",
          "ro": "Chan-da-naa-chee U-tee Kun-kum-ke-sha-raa",
          "type": "verse"
        },
        {
          "id": "GAN-007",
          "mr": "हिरेजडित मुकुट शोभतो बरा ।",
          "ro": "Hi-re-ja-dit Mu-kut Sho-bha-to Ba-raa",
          "type": "verse"
        },
        {
          "id": "GAN-008",
          "mr": "रुणझुणती नूपुरे चरणी घागरिया ॥२॥",
          "ro": "Run-jhu-na-tee Noo-pu-re Cha-ra-nee Ghaa-ga-ri-yaa",
          "type": "verse"
        },
        {
          "id": "GAN-009",
          "mr": "लंबोदर पीतांबर फणिवरवंदना ।",
          "ro": "Lam-bo-dar Pee-taam-bar Pha-ni-var-van-da-naa",
          "type": "verse"
        },
        {
          "id": "GAN-010",
          "mr": "सरळ सोंड वक्रतुंड त्रिनयना ।",
          "ro": "Sa-ral Sond Vak-ra-tund Tri-na-ya-naa",
          "type": "verse"
        },
        {
          "id": "GAN-011",
          "mr": "दास रामाचा वाट पाहे सदना ।",
          "ro": "Daas Raa-maa-chaa Vaat Paa-he Sa-da-naa",
          "type": "verse"
        },
        {
          "id": "GAN-012",
          "mr": "संकटी पावावे निर्वाणी रक्षावे सुरवरवंदना ॥३॥",
          "ro": "San-ka-tee Paa-vaa-ve Nir-vaa-nee Rak-shaa-ve Su-ra-var-van-da-naa",
          "type": "verse"
        }
      ],
      "meaning": "Ganpati is hailed as the maker of happiness and the remover of sorrow, the one who ends all word of obstacles. His devotees are shown his beloved form: vermilion paste over every limb, a necklace of pearls at his throat, a jewelled crown, sandal and saffron, anklets that chime as he moves. The closing verse is the plea the whole aarti builds toward - come to us in danger, protect us at the final hour.",
      "tier": "core"
    },
    {
      "id": "SHA",
      "title_mr": "श्री शंकराची आरती",
      "title_en": "Shankar Aarti",
      "incipit_mr": "लवथवती विक्राळा",
      "seal": "॥ ओं नमः शिवाय ॥",
      "accent": "#2F6E96",
      "source_photo": "IMG_C1047950-69FC-44E4-B37C-1E1A009F3979.jpeg",
      "lines": [
        {
          "id": "SHA-001",
          "mr": "लवथवती विक्राळा ब्रह्मांडी माळा ।",
          "ro": "La-va-tha-va-tee Vik-raa-laa Brah-maan-dee Maa-laa",
          "type": "verse"
        },
        {
          "id": "SHA-002",
          "mr": "वीषे कंठी काळा त्रिनेत्री ज्वाळा ।",
          "ro": "Vee-she Kan-thee Kaa-laa Tri-net-ree Jwaa-laa",
          "type": "verse"
        },
        {
          "id": "SHA-003",
          "mr": "लावण्यसुंदर मस्तकी बाळा ।",
          "ro": "Laa-van-ya-sun-dar Mas-ta-kee Baa-laa",
          "type": "verse"
        },
        {
          "id": "SHA-004",
          "mr": "तेथुनिया जल निर्मळ वाहे झुळझुळा ॥१॥",
          "ro": "Te-thu-ni-yaa Jal Nir-mal Vaa-he Jhul-jhu-laa",
          "type": "verse"
        },
        {
          "id": "SHA-R01",
          "mr": "जय देव जय देव जय श्रीशंकरा ।",
          "ro": "Jai Dev Jai Dev Jai Shree-shan-ka-raa",
          "type": "refrain"
        },
        {
          "id": "SHA-R02",
          "mr": "आरती ओवाळू तुज कर्पूरगौरा ॥धृ॥",
          "ro": "Aar-tee O-vaa-loo Tuj Kar-poor-gau-raa",
          "type": "refrain"
        },
        {
          "id": "SHA-005",
          "mr": "कर्पूरगौरा भोळा नयनी विशाळा ।",
          "ro": "Kar-poor-gau-raa Bho-laa Na-ya-nee Vi-shaa-laa",
          "type": "verse"
        },
        {
          "id": "SHA-006",
          "mr": "अर्धांगी पार्वती सुमनांच्या माळा ।",
          "ro": "Ar-dhaan-gee Paar-va-tee Su-ma-naan-chyaa Maa-laa",
          "type": "verse"
        },
        {
          "id": "SHA-007",
          "mr": "विभूतीचे उधळण शितिकंठ नीळा ।",
          "ro": "Vi-bhoo-tee-che U-dha-lan Shi-ti-kanth Nee-laa",
          "type": "verse"
        },
        {
          "id": "SHA-008",
          "mr": "ऐसा शंकर शोभे उमावेल्हाळा ॥२॥",
          "ro": "Ai-saa Shan-kar Sho-bhe U-maa-vel-haa-laa",
          "type": "verse"
        },
        {
          "id": "SHA-009",
          "mr": "देवी दैत्यी सागरमंथन पै केले ।",
          "ro": "De-vee Dai-tyee Saa-gar-man-than Pai Ke-le",
          "type": "verse"
        },
        {
          "id": "SHA-010",
          "mr": "त्यामाजी अवचित हळाहळ जे उठिले ।",
          "ro": "Tyaa-maa-jee A-va-chit Ha-laa-hal Je U-thi-le",
          "type": "verse"
        },
        {
          "id": "SHA-011",
          "mr": "ते त्वां असुरपणे प्राशन केले ।",
          "ro": "Te Twaan A-sur-pa-ne Praa-shan Ke-le",
          "type": "verse"
        },
        {
          "id": "SHA-012",
          "mr": "नीळकंठ नाम प्रसिद्ध झाले ॥३॥",
          "ro": "Neel-kanth Naam Pra-siddh Jhaa-le",
          "type": "verse"
        },
        {
          "id": "SHA-013",
          "mr": "व्याघ्रांबर फणिवरधर सुंदर मदनारी ।",
          "ro": "Vyaagh-raam-bar Pha-ni-var-dhar Sun-dar Ma-da-naa-ree",
          "type": "verse"
        },
        {
          "id": "SHA-014",
          "mr": "पंचानन मनमोहन मुनिजनसुखकारी ।",
          "ro": "Pan-chaa-nan Man-mo-han Mu-ni-jan-sukh-kaa-ree",
          "type": "verse"
        },
        {
          "id": "SHA-015",
          "mr": "शतकोटीचे बीज वाचे उच्चारी ।",
          "ro": "Shat-ko-tee-che Beej Vaa-che Uch-chaa-ree",
          "type": "verse"
        },
        {
          "id": "SHA-016",
          "mr": "रघुकुलटिलक रामदासा अंतरी ॥४॥",
          "ro": "Ra-ghu-kul-ti-lak Raam-daa-saa An-ta-ree",
          "type": "verse"
        }
      ],
      "meaning": "Shiva is seen in the same breath as terrifying and beautiful - garlanded with the whole cosmos, the poison dark at his throat, fire in his third eye, and the crescent set tenderly on his head, with the pure Ganga running down from it. The aarti moves through Parvati at his side, the scattering of sacred ash, and the churning of the ocean, when the Halahal poison rose and Shiva alone drank it and so became Nilkanth, the blue-throated one. Ramdas signs the last verse: this Lord is held in the devotee's own heart.",
      "tier": "core"
    },
    {
      "id": "DEV",
      "title_mr": "श्री देवीची आरती",
      "title_en": "Devi Aarti",
      "incipit_mr": "दुर्गे दुर्घट भारी",
      "seal": "॥ श्री अंबिकायै नमः ॥",
      "accent": "#A4243B",
      "source_photo": "IMG_BEBD84BA-5DD0-4F0B-AEE7-BF86A20276F3.jpeg",
      "lines": [
        {
          "id": "DEV-001",
          "mr": "दुर्गे दुर्घट भारी तुजविण संसारी ।",
          "ro": "Dur-ge Dur-ghat Bhaa-ree Tuj-vin San-saa-ree",
          "type": "verse"
        },
        {
          "id": "DEV-002",
          "mr": "अनाथनाथे अंबे करुणा विस्तारी ।",
          "ro": "A-naath-naa-the Am-be Ka-ru-naa Vis-taa-ree",
          "type": "verse"
        },
        {
          "id": "DEV-003",
          "mr": "वारी वारी जन्ममरणाते वारी ।",
          "ro": "Vaa-ree Vaa-ree Jan-ma-ma-ra-naa-te Vaa-ree",
          "type": "verse"
        },
        {
          "id": "DEV-004",
          "mr": "हारी पडलो आता संकट निवारी ॥१॥",
          "ro": "Haa-ree Pa-da-lo Aa-taa San-kat Ni-vaa-ree",
          "type": "verse"
        },
        {
          "id": "DEV-R01",
          "mr": "जय देवी जय देवी महिषासुरमथिनी ।",
          "ro": "Jai De-vee Jai De-vee Ma-hi-shaa-sur-ma-thi-nee",
          "type": "refrain"
        },
        {
          "id": "DEV-R02",
          "mr": "सुरवरईश्वरवरदे तारक संजीवनी ॥धृ॥",
          "ro": "Sur-var-eesh-war-var-de Taa-rak San-jee-va-nee",
          "type": "refrain"
        },
        {
          "id": "DEV-005",
          "mr": "त्रिभुवनभुवनी पाहता तुजऐसी नाही ।",
          "ro": "Tri-bhu-van-bhu-va-nee Paa-ha-taa Tuj-ai-see Naa-hee",
          "type": "verse"
        },
        {
          "id": "DEV-006",
          "mr": "चारी श्रमले परंतु न बोलवे काही ।",
          "ro": "Chaa-ree Shra-ma-le Pa-ran-tu Na Bo-la-ve Kaa-hee",
          "type": "verse"
        },
        {
          "id": "DEV-007",
          "mr": "साही विवाद करिता पडिले प्रवाही ।",
          "ro": "Saa-hee Vi-vaad Ka-ri-taa Pa-di-le Pra-vaa-hee",
          "type": "verse"
        },
        {
          "id": "DEV-008",
          "mr": "ते तू भक्तालागी पावसी लवलाही ॥२॥",
          "ro": "Te Too Bhak-taa-laa-gee Paa-va-see La-va-laa-hee",
          "type": "verse"
        },
        {
          "id": "DEV-009",
          "mr": "प्रसन्नवदने प्रसन्न होसी निजदासा ।",
          "ro": "Pra-sann-va-da-ne Pra-sann Ho-see Nij-daa-saa",
          "type": "verse"
        },
        {
          "id": "DEV-010",
          "mr": "क्लेशापासुनि सोडवी तोडी भवपाशा ।",
          "ro": "Kle-shaa-paa-su-ni So-da-vee To-dee Bha-va-paa-shaa",
          "type": "verse"
        },
        {
          "id": "DEV-011",
          "mr": "अंबे तुजवाचून कोण पुरविल आशा ।",
          "ro": "Am-be Tuj-vaa-choon Kon Pu-ra-vil Aa-shaa",
          "type": "verse"
        },
        {
          "id": "DEV-012",
          "mr": "नरहरि तल्लीन झाला पदपंकजलेशा ॥३॥",
          "ro": "Na-ra-ha-ri Tal-leen Jhaa-laa Pad-pan-kaj-le-shaa",
          "type": "verse"
        }
      ],
      "meaning": "The Mother is called by the name that means the un-crossable: Durga, without whom this world is too hard to cross. She is refuge for those who have none, and the devotee asks her plainly to end the round of birth and death and to lift the danger at hand. The middle verses confess that the four Vedas and the six schools of philosophy wore themselves out and still could not describe her, yet she comes at once to anyone who simply loves her. Narahari, the poet, ends lost at the dust of her lotus feet.",
      "tier": "core"
    },
    {
      "id": "DAT",
      "title_mr": "श्री दत्ताची आरती",
      "title_en": "Datta Aarti",
      "incipit_mr": "त्रिगुणात्मक त्रैमूर्ति",
      "seal": "॥ श्री गुरुदेव दत्त ॥",
      "accent": "#B0742A",
      "source_photo": "IMG_75CB5BA4-43BB-4339-A81D-19C2C626CAC1.jpeg",
      "lines": [
        {
          "id": "DAT-001",
          "mr": "त्रिगुणात्मक त्रैमूर्ति दत्त हा जाणा ।",
          "ro": "Tri-gu-naat-mak Trai-moor-ti Dat-ta Haa Jaa-naa",
          "type": "verse"
        },
        {
          "id": "DAT-002",
          "mr": "त्रिगुणी अवतार त्रैलोक्यराणा ।",
          "ro": "Tri-gu-nee A-va-taar Trai-lok-ya-raa-naa",
          "type": "verse"
        },
        {
          "id": "DAT-003",
          "mr": "नेति नेति शब्द नये अनुमाना ।",
          "ro": "Ne-ti Ne-ti Shabd Na-ye A-nu-maa-naa",
          "type": "verse"
        },
        {
          "id": "DAT-004",
          "mr": "सुरवरमुनिजन योगी समाधी न ये ध्याना ॥१॥",
          "ro": "Sur-var-mu-ni-jan Yo-gee Sa-maa-dhee Na Ye Dhyaa-naa",
          "type": "verse"
        },
        {
          "id": "DAT-R01",
          "mr": "जय देव जय देव जय श्रीगुरुदत्ता ।",
          "ro": "Jai Dev Jai Dev Jai Shree-gu-ru-dat-taa",
          "type": "refrain"
        },
        {
          "id": "DAT-R02",
          "mr": "आरती ओवाळिता हरली भवचिंता ॥धृ॥",
          "ro": "Aar-tee O-vaa-li-taa Har-lee Bhav-chin-taa",
          "type": "refrain"
        },
        {
          "id": "DAT-005",
          "mr": "सबाह्य अभ्यंतरी तू एक दत्त ।",
          "ro": "Sa-baah-ya Abh-yan-ta-ree Too Ek Datt",
          "type": "verse"
        },
        {
          "id": "DAT-006",
          "mr": "अभाग्यासी कैची कळेल हे मात ।",
          "ro": "A-bhaag-yaa-see Kai-chee Ka-lel He Maat",
          "type": "verse"
        },
        {
          "id": "DAT-007",
          "mr": "पराही परतली तेथे कैचा हा हेत ।",
          "ro": "Pa-raa-hee Pa-ra-ta-lee Te-the Kai-chaa Haa Het",
          "type": "verse"
        },
        {
          "id": "DAT-008",
          "mr": "जन्ममरणाचा पुरलासे अंत ॥२॥",
          "ro": "Jan-ma-ma-ra-naa-chaa Pu-ra-laa-se Ant",
          "type": "verse"
        },
        {
          "id": "DAT-009",
          "mr": "दत्त येऊनिया उभा ठाकला ।",
          "ro": "Dat-ta Ye-oo-ni-yaa U-bhaa Thaa-ka-laa",
          "type": "verse"
        },
        {
          "id": "DAT-010",
          "mr": "भावे साष्टांगेसी प्रणिपात केला ।",
          "ro": "Bhaa-ve Saash-taan-ge-see Pra-ni-paat Ke-laa",
          "type": "verse"
        },
        {
          "id": "DAT-011",
          "mr": "प्रसन्न होऊनि आशीर्वाद दिधला ।",
          "ro": "Pra-sann Ho-oo-ni Aa-sheer-vaad Di-dha-laa",
          "type": "verse"
        },
        {
          "id": "DAT-012",
          "mr": "जन्ममरणाचा फेरा चुकविला ॥३॥",
          "ro": "Jan-ma-ma-ra-naa-chaa Phe-raa Chu-ka-vi-laa",
          "type": "verse"
        },
        {
          "id": "DAT-013",
          "mr": "दत्त दत्त ऐसे लागले ध्यान ।",
          "ro": "Dat-ta Dat-ta Ai-se Laa-ga-le Dhyaan",
          "type": "verse"
        },
        {
          "id": "DAT-014",
          "mr": "हरपले मन झाले उन्मन ।",
          "ro": "Har-pa-le Man Jhaa-le Un-man",
          "type": "verse"
        },
        {
          "id": "DAT-015",
          "mr": "मी तू झाली बोळवण ।",
          "ro": "Mee Too Jhaa-lee Bo-la-van",
          "type": "verse"
        },
        {
          "id": "DAT-016",
          "mr": "एका जनार्दनी श्रीदत्तध्यान ॥४॥",
          "ro": "E-kaa Ja-naar-da-nee Shree-dat-ta-dhyaan",
          "type": "verse"
        }
      ],
      "meaning": "Dattatreya is the three qualities in one form, the ruler of the three worlds, and finally beyond every description - neti, neti, not this, not this. He is outside and inside alike, one single Datta, though the unlucky mind cannot take the news in. The aarti then turns to what actually happens: Datta comes and stands before the devotee, who falls full-length in love, and receives the blessing that ends the wheel of birth and death. In the last verse the meditation has gone so deep that the difference between me and you has quietly been seen off.",
      "tier": "core"
    },
    {
      "id": "DNY",
      "title_mr": "श्री ज्ञानदेवाची आरती",
      "title_en": "Dnyandev Aarti",
      "incipit_mr": "आरती ज्ञानराजा",
      "seal": "॥ श्री ज्ञानदेव तुकाराम ॥",
      "accent": "#2E7D6B",
      "tier": "core",
      "source_photo": "(see notes/DIVERGENCES.md)",
      "lines": [
        {
          "id": "DNY-001",
          "mr": "आरती ज्ञानराजा । महाकैवल्यतेजा ।",
          "ro": "Aar-tee Dnyaan-raa-jaa  Ma-haa-kai-val-ya-te-jaa",
          "type": "refrain"
        },
        {
